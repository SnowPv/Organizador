{
  "name": "Organizador BlackLine",
  "short_name": "Organizador",
  "description": "Tareas, proyectos y progreso del día",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAFAFC",
  "theme_color": "#FAFAFC",
  "lang": "es",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?compartir=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "chat",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            "application/x-zip-compressed",
            ".zip"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Hoy",
      "short_name": "Hoy",
      "description": "Tu día en 3 pasos",
      "url": "./?tab=hoy",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Negociaciones",
      "url": "./?tab=negocios",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tareas",
      "url": "./?tab=tareas",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}